rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    /// Returns true if the request is from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true if the authenticated user matches the given userId.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /// Returns the user document for the authenticated user.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Returns true if the authenticated user has the laundryOwner or staff role.
    function isLaundryStaff() {
      let userData = getUserData();
      return userData.role == 'laundryOwner' || userData.role == 'staff';
    }

    /// Returns true if the authenticated user is a customer.
    function isCustomer() {
      return getUserData().role == 'customer';
    }

    // ==================== USERS COLLECTION ====================

    match /users/{userId} {
      // Users can read their own profile
      // Laundry staff can read customer profiles (for order creation)
      allow read: if isOwner(userId) || isLaundryStaff();

      // Users can create their own profile
      allow create: if isOwner(userId);

      // Users can update their own profile
      // Laundry staff can create customer placeholder profiles
      allow update: if isOwner(userId) || isLaundryStaff();

      // Only the user themselves can delete their profile
      allow delete: if isOwner(userId);
    }

    // ==================== ORDERS COLLECTION ====================

    match /orders/{orderId} {
      // Customers can read their own orders
      // Laundry staff can read orders for their laundry
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.laundryId == request.auth.uid ||
        isLaundryStaff()
      );

      // Only laundry staff can create orders
      allow create: if isAuthenticated() && isLaundryStaff() &&
        request.resource.data.keys().hasAll([
          'customerId', 'customerName', 'customerPhone',
          'laundryId', 'items', 'status', 'totalPrice',
          'createdAt', 'estimatedCompletionTime', 'createdByStaffId'
        ]);

      // Laundry staff can update order status and details
      // Customers can only update rating fields
      allow update: if isAuthenticated() && (
        // Staff can update any field
        (isLaundryStaff() && resource.data.laundryId == request.auth.uid) ||
        // Customers can only add ratings to delivered orders
        (resource.data.customerId == request.auth.uid &&
         resource.data.status == 'delivered' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['rating', 'ratingComment']))
      );

      // Orders cannot be deleted (only cancelled via status update)
      allow delete: if false;
    }

    // ==================== RATINGS COLLECTION ====================

    match /ratings/{ratingId} {
      // Anyone authenticated can read ratings
      allow read: if isAuthenticated();

      // Customers can create ratings for their delivered orders
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      // Ratings cannot be updated or deleted
      allow update, delete: if false;
    }

    // ==================== NOTIFICATIONS COLLECTION ====================

    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Only Cloud Functions can create notifications (via admin SDK)
      allow create: if false;

      // Users can mark their notifications as read
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // ==================== LAUNDRIES COLLECTION ====================

    match /laundries/{laundryId} {
      // Anyone can read laundry info (for customer app)
      allow read: if isAuthenticated();

      // Only the laundry owner can create/update their profile
      allow create, update: if isOwner(laundryId);

      allow delete: if false;
    }

    // ==================== DEFAULT DENY ====================

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
